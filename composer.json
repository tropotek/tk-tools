{
  "name": "ttek/tk-tools",
  "type": "project",
  "description": "Tk lib framework commands.",
  "keywords": [
    "Tbx",
    "tools",
    "tropotek"
  ],
  "time": "2010-12-09",
  "license": "MIT",
  "authors": [
    {
      "name": "Michael Mifsud",
      "homepage": "http://www.tropotek.com/"
    }
  ],
  "minimum-stability": "dev",
  "autoload": {
    "psr-0": {
      "Tbx\\": "src/"
    }
  },
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-curl": "*",
    "ttek/tk-base": "^8.0.0"
  },
  "require-dev": {
    "composer/composer": "^2.0"
  },
  "extra": {
    "branch-alias": {
      "dev-master": "8.0.x-dev"
    }
  },
  "config": {
    "allow-plugins": {
      "ttek/tk-installers": true
    }
  }
}
